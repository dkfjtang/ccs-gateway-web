# syntax=docker/dockerfile:1
FROM node:22-bookworm AS frontend
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json ./
RUN pnpm install --no-frozen-lockfile
COPY . .
RUN pnpm build:web

FROM rust:1.95-bookworm AS server-builder
WORKDIR /app
COPY . .
COPY --from=frontend /app/dist ./dist
RUN mkdir -p .cargo && printf '[source.crates-io]\nreplace-with = "rsproxy-sparse"\n\n[source.rsproxy-sparse]\nregistry = "sparse+https://rsproxy.cn/index/"\n' > .cargo/config.toml     && rm -f rust-toolchain rust-toolchain.toml     && cargo build --manifest-path crates/server/Cargo.toml --release

FROM debian:bookworm-slim AS runtime
COPY --from=server-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=server-builder /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libssl.so.3
COPY --from=server-builder /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3
COPY --from=server-builder /app/crates/server/target/release/cc-switch-web /usr/local/bin/cc-switch-web
ENV CC_SWITCH_HOST=0.0.0.0 \
    CC_SWITCH_PORT=17666 \
    CC_SWITCH_AUTO_PORT=false \
    RUST_LOG=cc_switch_server=info,tower_http=info
EXPOSE 17666 15721
CMD ["/usr/local/bin/cc-switch-web"]
